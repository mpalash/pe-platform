{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSourcesAndRunState",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::aam-purgatory-archive",
        "arn:aws:s3:::aam-purgatory-archive/Experience Log/*",
        "arn:aws:s3:::aam-purgatory-archive/x_logs/*",
        "arn:aws:s3:::aam-purgatory-archive/_xlog-run/*"
      ]
    },
    {
      "Sid": "StageTheScriptCopyCsvsWriteTheIndex",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::aam-purgatory-archive/x_logs/*",
        "arn:aws:s3:::aam-purgatory-archive/_xlog-run/*"
      ]
    },
    {
      "Sid": "CreateAndTearDownTheTranscodeRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:CreateInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::448302912553:role/pe-xlog-transcode",
        "arn:aws:iam::448302912553:instance-profile/pe-xlog-transcode"
      ]
    },
    {
      "Sid": "HandTheRoleToEc2Only",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::448302912553:role/pe-xlog-transcode",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "LaunchWatchAndStopTheInstanceInStockholmOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateTags",
        "ec2:TerminateInstances",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeImages",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeInstanceTypes",
        "ec2:GetConsoleOutput"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "ResolveTheUbuntuAmi",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:eu-north-1::parameter/aws/service/canonical/*"
    },
    {
      "Sid": "NeverWriteToAnyExistingFolder",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:RestoreObject"
      ],
      "Resource": [
        "arn:aws:s3:::aam-purgatory-archive/Experience Log/*",
        "arn:aws:s3:::aam-purgatory-archive/Clips 480p/*",
        "arn:aws:s3:::aam-purgatory-archive/Clips HD/*",
        "arn:aws:s3:::aam-purgatory-archive/Thumbnails/*",
        "arn:aws:s3:::aam-purgatory-archive/static/*",
        "arn:aws:s3:::aam-purgatory-archive/texts/*",
        "arn:aws:s3:::aam-purgatory-archive/Audio overlay for data wall/*",
        "arn:aws:s3:::aam-purgatory-archive/Purgatory EDIT_Intro_Cyber Performance/*"
      ]
    },
    {
      "Sid": "NeverDeleteAnythingOrTouchTheBucketPolicy",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::aam-purgatory-archive",
        "arn:aws:s3:::aam-purgatory-archive/*"
      ]
    }
  ]
}
