{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheArchiveBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::aam-purgatory-archive",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "Clips 480p/*",
            "hls/*",
            "_hls-run/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadSourceClipsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::aam-purgatory-archive/Clips 480p/*",
        "arn:aws:s3:::aam-purgatory-archive/_hls-run/hls.sh"
      ]
    },
    {
      "Sid": "WriteHlsOutputAndRunLogsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::aam-purgatory-archive/hls/*",
        "arn:aws:s3:::aam-purgatory-archive/_hls-run/runs/*"
      ]
    },
    {
      "Sid": "NeverDeleteAnything",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::aam-purgatory-archive",
        "arn:aws:s3:::aam-purgatory-archive/*"
      ]
    }
  ]
}
