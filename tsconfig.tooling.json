{
  // Covers what Nuxt's generated projects do not: build scripts and tests.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true
  },
  "include": ["scripts/**/*.ts", "test/**/*.ts", "shared/**/*.ts", "vitest.config.ts"]
}
