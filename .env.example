# Copy to .env before the first `docker compose up`:
#   cp .env.example .env
#
# These are local development values. They are deliberately weak and deliberately
# committed — nothing here is a real secret, and nothing here is used deployed.
# Every variable the app reads appears in this file. (Phase 1 §1.1)

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=pe_platform
POSTGRES_USER=directus
POSTGRES_PASSWORD=directus
POSTGRES_PORT=5432

# ─── Directus ────────────────────────────────────────────────────────────────
DIRECTUS_PORT=8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
# Signs Directus's own tokens. Generate a real one for any deployed environment.
DIRECTUS_SECRET=local-development-secret-not-for-deployment
# Created on first boot. Sign in to http://localhost:8055 with these.
# NOTE: Directus validates with Joi, which checks the TLD against the IANA
# list. `admin@localhost` and `admin@anything.test` are both rejected, and
# bootstrap then fails silently, leaving no admin user. example.com is the
# reserved address (RFC 2606) that actually passes.
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=directus-local-admin
# Static token for the admin user. SERVER-ONLY — this must never reach the
# browser bundle. `pnpm test` has a test that asserts exactly that.
DIRECTUS_SERVICE_TOKEN=local-development-service-token
DIRECTUS_LOG_LEVEL=info

# ─── Directus file storage (editor uploads) ──────────────────────────────────
# Which storage locations Directus knows about, in order. The FIRST is where new
# uploads are written; the rest stay readable. `local` alone — the default —
# writes to the directus_uploads Docker volume and needs no cloud account.
#
# To put new uploads on S3 while everything already uploaded keeps resolving:
#   DIRECTUS_STORAGE_LOCATIONS=s3,local
#
# A file records its location in `directus_files.storage` at upload time and it
# is never rewritten. That is what makes the switch reversible — and why
# removing `local` from the list breaks every file uploaded before it.
DIRECTUS_STORAGE_LOCATIONS=local

# The assets bucket — Directus editor uploads only, never the archive bucket
# (Phase 3 §3.5). EU region, to match the residency choice in DEPLOYMENT §7.
AWS_ASSETS_BUCKET=
AWS_ASSETS_REGION=eu-north-1
AWS_ASSETS_ENDPOINT=s3.eu-north-1.amazonaws.com
# Optional key prefix. Empty means the bucket root.
AWS_ASSETS_ROOT=
# IAM user scoped to this bucket alone. Read by the Directus container only —
# Nuxt never sees these, so they cannot reach the browser bundle.
AWS_ASSETS_ACCESS_KEY_ID=
AWS_ASSETS_SECRET_ACCESS_KEY=

# ─── Mailpit (local SMTP trap; stands in for SES) ────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
EMAIL_FROM=no-reply@example.com

# ─── Nuxt / Nitro ────────────────────────────────────────────────────────────
# Nitro reads these into runtimeConfig. Server-only unless prefixed NUXT_PUBLIC_.
NUXT_DIRECTUS_URL=http://localhost:8055
NUXT_DIRECTUS_SERVICE_TOKEN=local-development-service-token
# Only while PRERENDERING the editorial pages during `pnpm build`. Deployed, the
# server reaches Directus on a private network the build cannot use, so this
# is the public address. Empty locally: NUXT_DIRECTUS_URL serves both.
PRERENDER_DIRECTUS_URL=

NUXT_SMTP_HOST=localhost
NUXT_SMTP_PORT=1025
NUXT_SMTP_FROM=no-reply@example.com

# Guards the Directus Live Preview route. Server-only.
NUXT_PREVIEW_TOKEN=local-development-preview-token

# Keeps a deployment out of search results (X-Robots-Tag: noindex, nofollow on
# every response). True for staging hosts like next.purgatoryedit.com, which
# serve the same content as the live www site. Leave false locally and in
# production.
NUXT_NOINDEX=false

NUXT_SESSION_COOKIE_NAME=pe_session
# Secure cookies do not set over plain HTTP — false locally, true deployed.
NUXT_SESSION_COOKIE_SECURE=false
# How long someone stays signed in. Open question Q6; 30 days is a placeholder.
NUXT_SESSION_TTL_DAYS=30

NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Public — the browser builds asset URLs from it. Not a credential.
NUXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# ─── Analytics: self-hosted Umami (ADR-006) ──────────────────────────────────
# Traffic and key events. Cookieless, no PII, no consent banner — but the
# Disclaimers page still owes readers a plain-language line saying it exists.
#
# The container shares the Postgres above in its own database. On a FRESH volume
# scripts/postgres/10-umami-db.sh creates it; an existing checkout needs, once:
#
#   docker compose exec postgres createdb -U directus umami
#
# Then open http://localhost:3001, sign in with the Umami default admin/umami,
# change that password, add a website, and paste its ID below.
UMAMI_PORT=3001
UMAMI_DB=umami
# Salts the daily visitor hash. Rotating it makes returning visitors look new.
UMAMI_APP_SECRET=local-development-umami-secret

# Both are public by design — the website id ships in the tracker script tag.
# LEAVE THESE EMPTY to run with no analytics at all; that is the default and
# nothing breaks without them.
NUXT_PUBLIC_UMAMI_HOST=http://localhost:3001
NUXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── Archive media ───────────────────────────────────────────────────────────
# usePlaybackSource is the only thing that reads these.
#
# Live distribution (created 2026-08-28): https://media.purgatoryedit.com/
#   CloudFront E14R1GQONP585I -> d3mqgdbv58bwmw.cloudfront.net
#   origin aam-purgatory-archive.s3.eu-north-1.amazonaws.com, ACM cert in us-east-1,
#   Managed-CachingOptimized + Managed-CORS-With-Preflight (the galaxy loads
#   thumbnails into WebGL textures with crossOrigin=anonymous and needs the headers).
#
# NUXT_PUBLIC_MEDIA_BASE is a CloudFront distribution and is what a deployed
# environment must use. It does not exist yet — Phase 3 §3.2 provisions it.
NUXT_PUBLIC_MEDIA_BASE=
#
# The raw S3 bucket carried over from pe-vue. Serving video from here is billed
# at $0.09/GB per view, which is why hard rule 3 forbids it. It is allowed
# locally, behind an explicit opt-in, so the player can actually be exercised —
# and it warns on every page load. Never set the flag in a deployed environment.
NUXT_PUBLIC_MEDIA_ORIGIN=https://aam-purgatory-archive.s3.eu-north-1.amazonaws.com/
NUXT_PUBLIC_MEDIA_ALLOW_ORIGIN_FALLBACK=true
