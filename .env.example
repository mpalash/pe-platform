# Copy to .env before the first `docker compose up`:
#   cp .env.example .env
#
# These are local development values. They are deliberately weak and deliberately
# committed — nothing here is a real secret, and nothing here is used deployed.
# Every variable the app reads appears in this file. (Phase 1 §1.1)

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=pe_platform
POSTGRES_USER=directus
POSTGRES_PASSWORD=directus
POSTGRES_PORT=5432

# ─── Directus ────────────────────────────────────────────────────────────────
DIRECTUS_PORT=8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
# Signs Directus's own tokens. Generate a real one for any deployed environment.
DIRECTUS_SECRET=local-development-secret-not-for-deployment
# Created on first boot. Sign in to http://localhost:8055 with these.
# NOTE: Directus validates with Joi, which checks the TLD against the IANA
# list. `admin@localhost` and `admin@anything.test` are both rejected, and
# bootstrap then fails silently, leaving no admin user. example.com is the
# reserved address (RFC 2606) that actually passes.
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=directus-local-admin
# Static token for the admin user. SERVER-ONLY — this must never reach the
# browser bundle. `pnpm test` has a test that asserts exactly that.
DIRECTUS_SERVICE_TOKEN=local-development-service-token
DIRECTUS_LOG_LEVEL=info

# ─── Mailpit (local SMTP trap; stands in for SES) ────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
EMAIL_FROM=no-reply@example.com

# ─── Nuxt / Nitro ────────────────────────────────────────────────────────────
# Nitro reads these into runtimeConfig. Server-only unless prefixed NUXT_PUBLIC_.
NUXT_DIRECTUS_URL=http://localhost:8055
NUXT_DIRECTUS_SERVICE_TOKEN=local-development-service-token

NUXT_SMTP_HOST=localhost
NUXT_SMTP_PORT=1025
NUXT_SMTP_FROM=no-reply@example.com

NUXT_SESSION_COOKIE_NAME=pe_session
# Secure cookies do not set over plain HTTP — false locally, true deployed.
NUXT_SESSION_COOKIE_SECURE=false
# How long someone stays signed in. Open question Q6; 30 days is a placeholder.
NUXT_SESSION_TTL_DAYS=30

NUXT_PUBLIC_SITE_URL=http://localhost:3000
